# MODEL_GATEWAY_UPSTREAM 由环境变量注入（nginx 镜像启动时用 envsubst 替换）
# 网关短暂重启后应立即允许下一次原生重试；不能把地址摘除 10 秒并耗尽原生重试。
# 地址按名字定时重新查（Docker 自带的 DNS，10 秒）：model-gateway 换了容器就换了 IP，
# 只在启动时查一次的话会一直连旧地址（2026-11-20 线上更新后沙箱里的回合全部 502）。
resolver 127.0.0.11 valid=10s ipv6=off;
upstream oasis_model_gateway {
  zone oasis_model_gateway 64k;
  server ${MODEL_GATEWAY_ADDRESS} max_fails=0 resolve;
}

server {
  listen 8080;
  client_max_body_size 50m;

  location = /healthz {
    access_log off;
    return 200 "ok\n";
  }

  location = /v1/chat/completions {
    proxy_pass ${MODEL_GATEWAY_PROTOCOL}://oasis_model_gateway/run/v1/chat/completions;
    include /etc/nginx/conf.d/sandbox-proxy.inc;
  }

  location = /v1/decisions {
    proxy_pass ${MODEL_GATEWAY_PROTOCOL}://oasis_model_gateway/run/v1/decisions;
    include /etc/nginx/conf.d/sandbox-proxy.inc;
  }

  # 沙箱里的 oasis-tool：看工具目录、调用工具
  location = /v1/tools {
    proxy_pass ${MODEL_GATEWAY_PROTOCOL}://oasis_model_gateway/run/v1/tools;
    include /etc/nginx/conf.d/sandbox-proxy.inc;
  }

  location /v1/tools/ {
    proxy_pass ${MODEL_GATEWAY_PROTOCOL}://oasis_model_gateway/run/v1/tools/;
    include /etc/nginx/conf.d/sandbox-proxy.inc;
  }
  location ~ ^/v1/tools/jobs/([a-f0-9-]+)/inputs/([0-9][0-9]?)$ {
    client_max_body_size 100m;
    proxy_pass ${MODEL_GATEWAY_PROTOCOL}://oasis_model_gateway/run/v1/tools/jobs/$1/inputs/$2;
    include /etc/nginx/conf.d/sandbox-proxy.inc;
  }

  # 确认卡：dsh 插件登记超出权限的事、等用户点（长轮询）；oasis-tool 等花钱工具的确认
  location = /v1/confirmations {
    proxy_pass ${MODEL_GATEWAY_PROTOCOL}://oasis_model_gateway/run/v1/confirmations;
    include /etc/nginx/conf.d/sandbox-proxy.inc;
  }

  location /v1/confirmations/ {
    proxy_pass ${MODEL_GATEWAY_PROTOCOL}://oasis_model_gateway/run/v1/confirmations/;
    include /etc/nginx/conf.d/sandbox-proxy.inc;
  }

  location / {
    return 403;
  }
}
