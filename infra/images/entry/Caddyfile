# 域名从环境变量 OASIS_DOMAIN 来；填的是公网域名时 Caddy 自己申请和续期证书，80 端口自动跳到 443。
{$OASIS_DOMAIN} {
	encode zstd gzip

	# 接口、推送（SSE）和桌面版的长连接（WebSocket）：收到就转发，不攒着
	handle /api/* {
		reverse_proxy gateway:8080 {
			flush_interval -1
		}
	}

	# 实时数字人的供应商从公网回调这里
	handle /avatar/v1/* {
		reverse_proxy model-gateway:4118 {
			flush_interval -1
		}
	}

	# 网页：带内容指纹的文件长期缓存；其余路径都交给 index.html（前端自己认路由），它每次都重新取
	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@page not path /assets/*
		header @page Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
