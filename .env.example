# 本地开发环境变量样例。运行 `pnpm env:init` 生成 .env：空着的密码和密钥会自动填入随机值。
# .env 不入库；上云后这些值改由平台的 Secret / ConfigMap 注入。

# —— PostgreSQL：一个实例，每个服务一个独立 database + 独立账号 ——
POSTGRES_SUPERUSER=oasis_admin
POSTGRES_SUPERUSER_PASSWORD=
IDENTITY_DB_PASSWORD=
BILLING_DB_PASSWORD=
AGENT_DB_PASSWORD=
CONVERSATION_DB_PASSWORD=
CANVAS_DB_PASSWORD=
HARNESS_DB_PASSWORD=
MODEL_GATEWAY_DB_PASSWORD=

# —— identity：验证码哈希用的密钥 ——
AUTH_CODE_PEPPER=

# —— NATS JetStream ——
NATS_USER=oasis
NATS_PASSWORD=

# —— SeaweedFS（S3 兼容对象存储）——
S3_ACCESS_KEY=
S3_SECRET_KEY=

# —— 宿主机端口（都只绑定 127.0.0.1）——
POSTGRES_HOST_PORT=5432
NATS_HOST_PORT=4222
NATS_MONITOR_HOST_PORT=8222
S3_HOST_PORT=8333
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025
GATEWAY_HOST_PORT=8080

# —— 线上（只在服务器上填，步骤见 docs/ops/部署.md）——
# 填了 OASIS_DOMAIN，pnpm stack:up 就连入口一起起（自动申请 HTTPS 证书）、不起 Mailpit
# OASIS_DOMAIN=oasis.example.com
# GATEWAY_ALLOWED_ORIGINS=https://oasis.example.com
# COOKIE_SECURE=true
# 发信服务：发信地址里的 @ 写成 %40；密码只用字母和数字
# SMTP_URL=smtps://noreply%40mail.example.com:<SMTP 密码>@smtpdm.aliyun.com:465
# MAIL_FROM=Oasis <noreply@mail.example.com>
# 中间件随 Docker 自动重启（本地不设，开机不抢内存）
# OASIS_RESTART=unless-stopped
# 同时最多跑几个沙箱，默认 4；机器小就调小
# MAX_CONCURRENT_RUNS=1
# 云端的沙箱租 E2B 的（这台机器就不用自己跑沙箱了）：先在开发机上 pnpm sandbox:e2b 把模板建好，再填这三行
# （同时能开几个看 E2B 的档位，Hobby 是 10）。沙箱里的 dsh 经 https://<OASIS_DOMAIN>/api/run/v1 调模型和工具
# CLOUD_EXECUTOR=e2b
# E2B_API_KEY=
# MAX_CONCURRENT_RUNS=10

# —— 沙箱（harness）——
# pnpm stack:up 时 harness 容器要通过宿主机的 Docker socket 起沙箱。
# Linux 上填 docker 组的 gid（getent group docker）；Docker Desktop 不用填
# DOCKER_SOCKET_GID=
# 沙箱里装软件包用的仓库，以及出口代理放行的域名。
# 开发机在国内，先用国内镜像站；部署到海外后换回官方源（只改这三项）：
#   SANDBOX_NPM_REGISTRY=https://registry.npmjs.org/
#   SANDBOX_PIP_INDEX_URL=https://pypi.org/simple
#   SANDBOX_EGRESS_ALLOW_HOSTS=registry.npmjs.org,pypi.org,files.pythonhosted.org
# 用户导入自己的项目时还要到代码托管站和各语言的包仓库：名单在 infra/images/sandbox-egress/project-hosts，
# 默认放行；不想放行就加一行 SANDBOX_EGRESS_PROJECT_HOSTS=off。
SANDBOX_NPM_REGISTRY=https://registry.npmmirror.com/
SANDBOX_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
SANDBOX_EGRESS_ALLOW_HOSTS=registry.npmmirror.com,cdn.npmmirror.com,pypi.tuna.tsinghua.edu.cn
# 构建沙箱镜像时用的 Debian 镜像站：只用来加快下载，装哪个版本由 Dockerfile 里的快照日期定（部署到海外后删掉这一行）
SANDBOX_APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn

# 联网搜索和网页抓取（Tavily）。只放在本地 .env，不进 git
TAVILY_API_KEY=

# 5.9 云渲染准备：供应商凭据由用户填写，不生成随机值。pnpm render:config 仅本地核对。
# Codex 的 Runpod 插件登录与 Oasis 运行时 Key 是两个独立配置。
RUNPOD_API_KEY=
# 镜像和 endpoint 尚未创建时留空，不要随意部署公共模板。
RUNPOD_ENDPOINT_ID=
RENDER_GHCR_NAMESPACE=
RENDER_GHCR_PUSH_TOKEN=
RENDER_GHCR_PULL_TOKEN=
RENDER_IMAGE_DIGEST=
RENDER_STAGING_S3_ENDPOINT=
RENDER_STAGING_S3_REGION=auto
RENDER_STAGING_S3_BUCKET=
RENDER_STAGING_S3_ACCESS_KEY=
RENDER_STAGING_S3_SECRET_KEY=
# 免费 CPU 建模/验证镜像，需先 pnpm sandbox:build:3d；不代表云 GPU 可用。
SANDBOX_3D_IMAGE=oasis/harness-sandbox-3d:0.2.1-rc.5-blender4.3.2
