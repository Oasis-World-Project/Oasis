# 本地开发环境变量样例。运行 `pnpm env:init` 生成 .env：空着的密码和密钥会自动填入随机值。
# .env 不入库；上云后这些值改由平台的 Secret / ConfigMap 注入。

# —— PostgreSQL：一个实例，每个服务一个独立 database + 独立账号 ——
POSTGRES_SUPERUSER=oasis_admin
POSTGRES_SUPERUSER_PASSWORD=
IDENTITY_DB_PASSWORD=
BILLING_DB_PASSWORD=
AGENT_DB_PASSWORD=
CONVERSATION_DB_PASSWORD=
TASK_DB_PASSWORD=
CANVAS_DB_PASSWORD=
HARNESS_DB_PASSWORD=
MODEL_GATEWAY_DB_PASSWORD=

# —— identity：验证码哈希用的密钥 ——
AUTH_CODE_PEPPER=

# —— Valkey（Redis 兼容）——
VALKEY_PASSWORD=

# —— NATS JetStream ——
NATS_USER=oasis
NATS_PASSWORD=

# —— SeaweedFS（S3 兼容对象存储）——
S3_ACCESS_KEY=
S3_SECRET_KEY=

# —— 宿主机端口（都只绑定 127.0.0.1）——
POSTGRES_HOST_PORT=5432
VALKEY_HOST_PORT=6379
NATS_HOST_PORT=4222
NATS_MONITOR_HOST_PORT=8222
S3_HOST_PORT=8333
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025
GATEWAY_HOST_PORT=8080

# —— 沙箱（harness）——
# pnpm stack:up 时 harness 容器要通过宿主机的 Docker socket 起沙箱。
# Linux 上填 docker 组的 gid（getent group docker）；Docker Desktop 不用填
# DOCKER_SOCKET_GID=

# 联网搜索和网页抓取（Tavily，ADR 0006）。只放在本地 .env，不进 git
TAVILY_API_KEY=
