{
  "name": "oasis",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "desktop": "pnpm --filter @oasis/desktop start",
    "typecheck": "turbo run typecheck",
    "test": "node --test scripts/dev-service.test.mjs && turbo run test",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "env:init": "node scripts/init-env.mjs",
    "infra:up": "node scripts/compose.mjs up",
    "infra:down": "node scripts/compose.mjs down",
    "infra:ps": "node scripts/compose.mjs ps",
    "stack:up": "node scripts/compose.mjs up --services",
    "stack:logs": "node scripts/compose.mjs logs",
    "sandbox:build": "node scripts/sandbox.mjs build",
    "sandbox:check": "node scripts/sandbox.mjs check",
    "sandbox:check:ops": "node scripts/sandbox.mjs check-ops",
    "sandbox:build:3d": "node scripts/sandbox.mjs build-3d",
    "sandbox:check:3d": "node scripts/sandbox.mjs check-3d",
    "render:config": "node scripts/render.mjs config",
    "render:build": "node scripts/render.mjs build",
    "render:check": "node scripts/render.mjs check",
    "render:tag": "node scripts/render.mjs tag",
    "browser:build": "node scripts/browser.mjs build",
    "browser:smoke": "node scripts/browser.mjs smoke",
    "model:smoke": "turbo run build --filter=@oasis/canvas... --filter=@oasis/harness... --filter=@oasis/desktop... && node scripts/model-preview.mjs",
    "media:smoke": "node --max-old-space-size=128 scripts/media.mjs",
    "media:recover": "node scripts/media.mjs recover",
    "video:smoke": "node scripts/video.mjs",
    "check:engineering": "node scripts/check-engineering.mjs",
    "e2e": "node scripts/e2e.mjs",
    "trace": "node scripts/trace.mjs",
    "accept": "node scripts/accept.mjs",
    "avatar:tunnel": "node scripts/avatar-tunnel.mjs",
    "cleanup": "node scripts/cleanup-task.mjs",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "17.13.0",
    "jscpd": "5.4.1",
    "knip": "6.42.1",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "turbo": "2.11.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "yaml": "2.9.1"
  }
}
