# canvas 本机开发配置。`pnpm env:init` 会据此生成 .env，并把 ${...} 换成仓库根目录 .env 里的值。
PORT=4106
HOST=127.0.0.1
LOG_LEVEL=info
# 启动时执行本服务的数据库迁移
MIGRATE_ON_START=true
DATABASE_URL=postgres://svc_canvas:${CANVAS_DB_PASSWORD}@127.0.0.1:${POSTGRES_HOST_PORT}/canvas?sslmode=disable
NATS_URL=nats://127.0.0.1:${NATS_HOST_PORT}
NATS_USER=${NATS_USER}
NATS_PASSWORD=${NATS_PASSWORD}
# 对象存储：用户上传的素材（以后还有成果）
S3_ENDPOINT=http://127.0.0.1:${S3_HOST_PORT}
S3_ACCESS_KEY=${S3_ACCESS_KEY}
S3_SECRET_KEY=${S3_SECRET_KEY}
# 单个上传文件的大小上限（字节），默认 100 MB
# UPLOAD_MAX_BYTES=104857600
