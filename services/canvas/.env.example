# canvas 本机开发配置。`pnpm env:init` 会据此生成 .env，并把 ${...} 换成仓库根目录 .env 里的值。
PORT=4106
HOST=127.0.0.1
LOG_LEVEL=info
# 启动时执行本服务的数据库迁移
MIGRATE_ON_START=true
DATABASE_URL=postgres://svc_canvas:${CANVAS_DB_PASSWORD}@127.0.0.1:${POSTGRES_HOST_PORT}/canvas?sslmode=disable
NATS_URL=nats://127.0.0.1:${NATS_HOST_PORT}
NATS_USER=${NATS_USER}
NATS_PASSWORD=${NATS_PASSWORD}
# 任务完成时取任务详情和成果文件，登记进画布
TASK_URL=http://127.0.0.1:4105
# 模型预览前的检查（几何、贴图、封面）
INSPECTOR_URL=http://127.0.0.1:4109
# 对象存储：用户上传的素材（以后还有成果）
S3_ENDPOINT=http://127.0.0.1:${S3_HOST_PORT}
S3_ACCESS_KEY=${S3_ACCESS_KEY}
S3_SECRET_KEY=${S3_SECRET_KEY}
# 流式上传单文件上限 512 MiB；总素材上限由 harness 再核对
UPLOAD_MAX_BYTES=536870912
UPLOAD_CONCURRENCY=2
ARCHIVE_MAX_BYTES=2147483648
# 文件转换在独立 worker 中执行；超过上限提示下载，不排无限队列
# PREVIEW_MAX_BYTES=20971520
# PREVIEW_UNZIP_MAX_BYTES=52428800
# PREVIEW_MAX_ENTRIES=2000
# PREVIEW_TIMEOUT_MS=10000
# PREVIEW_CONCURRENCY=2
# ARCHIVE_MAX_BYTES=104857600
# ARCHIVE_MAX_FILES=1000

FILE_TRANSFER_TIMEOUT_MS=600000
# 数字人会话由 model-gateway 开（ADR 0013）
MODEL_GATEWAY_URL=http://127.0.0.1:4108
