{
  "name": "@oasis/canvas",
  "version": "0.0.0",
  "private": true,
  "description": "画布：成果、批注、文件（存对象存储），每个成果只留最新一版",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node ../../scripts/dev-service.mjs src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1 --testTimeout=15000"
  },
  "dependencies": {
    "@oasis/contracts": "workspace:*",
    "@oasis/service-kit": "workspace:*",
    "drizzle-orm": "catalog:",
    "fflate": "catalog:",
    "mammoth": "1.13.0",
    "pg": "catalog:",
    "read-excel-file": "9.3.12",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@oasis/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "fastify": "catalog:",
    "pino": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
