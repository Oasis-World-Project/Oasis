# identity 本机开发配置。`pnpm env:init` 会据此生成 .env，并把 ${...} 换成仓库根目录 .env 里的值。
PORT=4101
HOST=127.0.0.1
LOG_LEVEL=info
# 启动时执行本服务的数据库迁移
MIGRATE_ON_START=true
DATABASE_URL=postgres://svc_identity:${IDENTITY_DB_PASSWORD}@127.0.0.1:${POSTGRES_HOST_PORT}/identity?sslmode=disable
NATS_URL=nats://127.0.0.1:${NATS_HOST_PORT}
NATS_USER=${NATS_USER}
NATS_PASSWORD=${NATS_PASSWORD}
# 验证码邮件：本地发到 Mailpit（收件箱 http://127.0.0.1:8025）
SMTP_URL=smtp://127.0.0.1:${MAILPIT_SMTP_HOST_PORT}
MAIL_FROM=Oasis <no-reply@oasis.local>
AUTH_CODE_PEPPER=${AUTH_CODE_PEPPER}
# 本地是 http，会话 Cookie 不能要求 HTTPS
COOKIE_SECURE=false
