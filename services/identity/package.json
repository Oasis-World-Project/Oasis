{
  "name": "@oasis/identity",
  "version": "0.0.0",
  "private": true,
  "description": "账号与登录（邮箱验证码），注册后发出 user.registered 事件",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@oasis/service-kit": "workspace:*"
  },
  "devDependencies": {
    "@oasis/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
