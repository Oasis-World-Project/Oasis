# inspector 本机开发配置。`pnpm env:init` 会据此生成 .env，并把 ${...} 换成仓库根目录 .env 里的值。
PORT=4109
HOST=127.0.0.1
LOG_LEVEL=info
# 只认对象存储签发的临时下载链接（运行产出、用户素材）
SOURCE_ORIGINS=http://127.0.0.1:${S3_HOST_PORT}
# 音视频解码：每次开一个不联网的检查容器，镜像要先构建（pnpm sandbox:build）。
# Docker 的 socket 一般不用填：Linux/macOS 默认 /var/run/docker.sock，Windows 默认 Docker Desktop 的命名管道。
# DOCKER_SOCKET=
MEDIA_CHECK_IMAGE=oasis/harness-sandbox-base:0.2.1-rc.5
MEDIA_CHECK_MAX_FILES=20
MEDIA_CHECK_MAX_DURATION_MS=1200000
MEDIA_CHECK_CONCURRENCY=2
# 文件解析的资源上限
EXTRACT_INPUT_BYTES=20971520
EXTRACT_UNZIP_BYTES=52428800
EXTRACT_MAX_ENTRIES=2000
EXTRACT_MAX_PAGES=200
EXTRACT_MAX_CELLS=20000
EXTRACT_MAX_PIXELS=25000000
EXTRACT_TIMEOUT_MS=10000
EXTRACT_TOTAL_MS=30000
EXTRACT_MAX_FILES=1000
