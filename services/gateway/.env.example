# gateway 本机开发配置。`pnpm env:init` 会据此生成 .env。
PORT=8080
HOST=127.0.0.1
LOG_LEVEL=info
IDENTITY_URL=http://127.0.0.1:4101
BILLING_URL=http://127.0.0.1:4102
AGENT_URL=http://127.0.0.1:4103
CONVERSATION_URL=http://127.0.0.1:4104
TASK_URL=http://127.0.0.1:4105
CANVAS_URL=http://127.0.0.1:4106
# 允许发起改数据请求的页面来源（逗号分隔）
GATEWAY_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
