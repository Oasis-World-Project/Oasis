{
  "name": "@oasis/model-gateway",
  "version": "0.0.0",
  "private": true,
  "description": "所有模型调用的唯一出口（OpenAI 兼容），计量后上报 billing",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@oasis/service-kit": "workspace:*"
  },
  "devDependencies": {
    "@oasis/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
