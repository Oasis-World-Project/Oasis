# model-gateway 本机开发配置。`pnpm env:init` 会据此生成 .env，并把 ${...} 换成仓库根目录 .env 里的值。
PORT=4108
HOST=127.0.0.1
LOG_LEVEL=info
# 启动时执行本服务的数据库迁移
MIGRATE_ON_START=true
DATABASE_URL=postgres://svc_model_gateway:${MODEL_GATEWAY_DB_PASSWORD}@127.0.0.1:${POSTGRES_HOST_PORT}/model_gateway?sslmode=disable
NATS_URL=nats://127.0.0.1:${NATS_HOST_PORT}
NATS_USER=${NATS_USER}
NATS_PASSWORD=${NATS_PASSWORD}
BILLING_URL=http://127.0.0.1:4102
# 在这里填你的 OpenRouter Key（这个文件不进 git）
OPENROUTER_API_KEY=
# 联网搜索和网页抓取（Tavily）：Key 填在仓库根目录的 .env（TAVILY_API_KEY），pnpm env:init 会带过来
TAVILY_API_KEY=${TAVILY_API_KEY}
# 5.6a 看图模型与输出上限；网页全文模式最大正文总字节数。
TOOL_VISION_MODELS=qwen/qwen3-vl-8b-instruct,google/gemini-2.5-flash
TOOL_VISION_MAX_TOKENS=2048
TOOL_FETCH_MAX_BYTES=5242880
