# model-gateway 本机开发配置。`pnpm env:init` 会据此生成 .env，并把 ${...} 换成仓库根目录 .env 里的值。
PORT=4108
HOST=127.0.0.1
LOG_LEVEL=info
# 启动时执行本服务的数据库迁移
MIGRATE_ON_START=true
DATABASE_URL=postgres://svc_model_gateway:${MODEL_GATEWAY_DB_PASSWORD}@127.0.0.1:${POSTGRES_HOST_PORT}/model_gateway?sslmode=disable
NATS_URL=nats://127.0.0.1:${NATS_HOST_PORT}
NATS_USER=${NATS_USER}
NATS_PASSWORD=${NATS_PASSWORD}
BILLING_URL=http://127.0.0.1:4102
CANVAS_URL=http://127.0.0.1:4106
# 5.7 Android 原生设备测试：仅在供应商确认为 Free 计划时启动。
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
BROWSERSTACK_API_URL=https://api-cloud.browserstack.com
BROWSERSTACK_HUB_URL=https://hub-cloud.browserstack.com/wd/hub
# 在这里填你的 OpenRouter Key（这个文件不进 git）
OPENROUTER_API_KEY=
# 模型聊天/决策请求的 JSON 字节上限，含历史和 base64 图片；不超过沙箱入口代理的 50 MiB。
MODEL_REQUEST_MAX_BYTES=52428800
# 单次回答最多输出多少 token（含推理）；dsh 会按整个上下文窗口要，供应商按输出上限预先核算花费
# MAX_OUTPUT_TOKENS=131072
# 联网搜索和网页抓取（Tavily）：Key 填在仓库根目录的 .env（TAVILY_API_KEY），pnpm env:init 会带过来
TAVILY_API_KEY=${TAVILY_API_KEY}
# 5.6a 看图模型与输出上限；网页全文模式最大正文总字节数。
TOOL_VISION_MODELS=qwen/qwen3.8-max-prime,moonshotai/kimi-k3.1-pro,google/gemini-4-argon,anthropic/claude-opus-5.5,qwen/qwen3-vl-235b-a22b-instruct,qwen/qwen3-vl-30b-a3b-instruct
TOOL_VISION_MAX_TOKENS=16000
TOOL_FETCH_MAX_BYTES=5242880
# 「只用国内模型」开关（ADR 0027）认的国内厂商（模型 ID 里「/」前面的部分）；不填用内置名单。
# DOMESTIC_MODEL_VENDORS=deepseek,qwen,alibaba,moonshotai,bytedance,bytedance-seed,kwaivgi,minimax,stepfun,tencent,xiaomi,z-ai

# 5.8a 媒体结果私有存储与音乐队列（FAL_API_KEY 只填本地 .env）
S3_ENDPOINT=http://127.0.0.1:${S3_HOST_PORT}
S3_ACCESS_KEY=${S3_ACCESS_KEY}
S3_SECRET_KEY=${S3_SECRET_KEY}
FAL_API_KEY=
# 5.9: keep disabled until provider model/price acceptance; API Key alone is insufficient.
TOOL_GEOMETRY_MODELS=
TOOL_GEOMETRY_MICRO_PER_GENERATION=350000
# 5.9 cloud render: keep false until private image, GPU isolation and pricing acceptance.
# 网络短暂断开（请求没发出去）时最多等多久（毫秒）再报错，节点才停下等用户点继续
UPSTREAM_RECONNECT_MS=600000
RUNPOD_API_KEY=${RUNPOD_API_KEY}
RUNPOD_ENDPOINT_ID=${RUNPOD_ENDPOINT_ID}
RUNPOD_BASE_URL=https://api.runpod.ai/v2
RENDER_PROFILE_VERIFIED=false
# 每次渲染冻结上限；≥ (600 秒执行 + 90 秒启动 + 5 秒空闲) × 373 = 259235，实际扣款不超过此值。
RENDER_HOLD_MICRO=300000
# 按 GPU 回执计量：(执行秒 + min(启动秒, 上限) + 空闲秒) × 锁定单价（微美元/秒），见 ADR 0011 §21。
RENDER_PRICE_MICRO_PER_SECOND=373
RENDER_STARTUP_ALLOWANCE_SECONDS=90
RENDER_IDLE_SECONDS=5
RENDER_STAGING_S3_ENDPOINT=${RENDER_STAGING_S3_ENDPOINT}
RENDER_STAGING_S3_REGION=${RENDER_STAGING_S3_REGION}
RENDER_STAGING_S3_BUCKET=${RENDER_STAGING_S3_BUCKET}
RENDER_STAGING_S3_ACCESS_KEY=${RENDER_STAGING_S3_ACCESS_KEY}
RENDER_STAGING_S3_SECRET_KEY=${RENDER_STAGING_S3_SECRET_KEY}
FAL_BASE_URL=https://queue.fal.run
FAL_MEDIA_HOSTS=fal.media
TOOL_MUSIC_MODELS=fal-ai/minimax-music/v2.6
TOOL_MUSIC_MICRO_PER_GENERATION=150000
TOOL_RESULT_MAX_BYTES=536870912
TOOL_RESULT_RETENTION_MS=604800000
TOOL_SUBMIT_TIMEOUT_MS=60000
# 实时数字人（LiveAvatar，ADR 0013）。Key 在 app.liveavatar.com/developers 生成；没填时数字人会话不可用
LIVEAVATAR_API_KEY=
LIVEAVATAR_BASE_URL=https://api.liveavatar.com
# 给 LiveAvatar 回调的大模型入口：单独端口，只有 /avatar/v1/chat/completions（经 SSH 反向隧道和服务器上的 nginx 暴露）
AVATAR_LLM_HOST=127.0.0.1
AVATAR_LLM_PORT=4118
# LiveAvatar 从公网访问上面那个入口的地址，写到 /avatar/v1 为止；开发期是 https://oasis-dev.elysiumgrid.space/avatar/v1
AVATAR_PUBLIC_BASE_URL=
AVATAR_MODEL=deepseek/deepseek-v4.1-flash
# 开发期所有数字人会话都用 LiveAvatar 沙箱（不扣积分，只有官方测试形象，约 1 分钟自动结束）
AVATAR_SANDBOX=false
AVATAR_CREDIT_MICRO=95000
AVATAR_SWEEP_MS=60000
# 浏览器检查（website.test、app.check）在 inspector 里做；检查浏览器用几核、一次冻结多久的算力
INSPECTOR_URL=http://127.0.0.1:4109
BROWSER_CHECK_CPUS=2
BROWSER_CHECK_MAX_MS=3600000
# 专用决策模型在当前地区不可用时，noul 判断经可用文本模型核验并按实际调用计费；留空关闭。
DECISION_FALLBACK_MODEL=deepseek/deepseek-v4.1-flash
# 估价参考调用记录：开发阶段记录多来自失控的运行，先关掉，只按价格表估；稳定后改 true
# ESTIMATE_FROM_HISTORY=false
# 不看记录时一个干活节点按多少 token 估（乘型号单价）
# ESTIMATE_NODE_PROMPT_TOKENS=600000
# ESTIMATE_NODE_COMPLETION_TOKENS=40000
