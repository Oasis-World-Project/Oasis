{
  "name": "@oasis/task",
  "version": "0.0.0",
  "private": true,
  "description": "工作流控制面：任务的节点图、状态机、调度、重做、追问路由（ADR 0004）",
  "type": "module",
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@oasis/contracts": "workspace:*",
    "@oasis/service-kit": "workspace:*",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@oasis/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "fastify": "catalog:",
    "pino": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
