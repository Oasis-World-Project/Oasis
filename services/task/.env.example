# task 本机开发配置。`pnpm env:init` 会据此生成 .env，并把 ${...} 换成仓库根目录 .env 里的值。
PORT=4105
HOST=127.0.0.1
LOG_LEVEL=info
# 启动时执行本服务的数据库迁移
MIGRATE_ON_START=true
DATABASE_URL=postgres://svc_task:${TASK_DB_PASSWORD}@127.0.0.1:${POSTGRES_HOST_PORT}/task?sslmode=disable
NATS_URL=nats://127.0.0.1:${NATS_HOST_PORT}
NATS_USER=${NATS_USER}
NATS_PASSWORD=${NATS_PASSWORD}
# 节点在 harness 里执行
HARNESS_URL=http://127.0.0.1:4107
# 节点出口关卡用决策模型（Jev）判断验收点
MODEL_GATEWAY_URL=http://127.0.0.1:4108
GATE_MODEL=typesafe/jev-1.14
# 长证据提取和复核模型（用强力模型）；正文额度为每个提取窗口容量，不是整个任务的读取上限。
GATE_EVIDENCE_MODEL=deepseek/deepseek-v4-pro-0813
# 规划员和节点默认型号（ADR 0016：标准和精细档用 DeepSeek 最强型号，省钱档用快速型号）
# PLANNER_MODEL=deepseek/deepseek-v4-pro-0813
# PLANNER_ECONOMY_MODEL=deepseek/deepseek-v4.1-flash
# DEFAULT_NODE_MODEL=deepseek/deepseek-v4-pro-0813
# 任务单报价时列草案的便宜模型
# QUOTE_MODEL=deepseek/deepseek-v4.1-flash
# 估价兜底：只在型号没有调用记录、价格表也算不出时用（结果标成粗估）
# ESTIMATE_WORK_RUN_MICRO=300000
# ESTIMATE_SPEECH_RUN_MICRO=50000
# ESTIMATE_NODE_SECONDS=600
# GATE_TEXT_MAX_CHARS=50000
GATE_THRESHOLD=0.5
# 规划员查模型目录
AGENT_URL=http://127.0.0.1:4103
GATE_VISION_MAX_IMAGES=4
GATE_VISION_MAX_BYTES=20971520
HARNESS_CHECK_TIMEOUT_MS=40000
