# task 本机开发配置。`pnpm env:init` 会据此生成 .env，并把 ${...} 换成仓库根目录 .env 里的值。
PORT=4105
HOST=127.0.0.1
LOG_LEVEL=info
# 启动时执行本服务的数据库迁移
MIGRATE_ON_START=true
DATABASE_URL=postgres://svc_task:${TASK_DB_PASSWORD}@127.0.0.1:${POSTGRES_HOST_PORT}/task?sslmode=disable
NATS_URL=nats://127.0.0.1:${NATS_HOST_PORT}
NATS_USER=${NATS_USER}
NATS_PASSWORD=${NATS_PASSWORD}
# 节点在 harness 里执行
HARNESS_URL=http://127.0.0.1:4107
# 节点出口关卡用决策模型（Jev）判断验收点
MODEL_GATEWAY_URL=http://127.0.0.1:4108
GATE_MODEL=typesafe/jev-1.14
GATE_THRESHOLD=0.5
