{
  "name": "@oasis/conversation",
  "version": "0.0.0",
  "private": true,
  "description": "私聊和群聊：私聊里的 AI 就是干活的主 AI（一轮是 harness 的一次运行）；群聊的群、成员、邀请和消息",
  "type": "module",
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "dev": "node ../../scripts/dev-service.mjs src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@oasis/contracts": "workspace:*",
    "@oasis/service-kit": "workspace:*",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@oasis/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "fastify": "catalog:",
    "pino": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
