# conversation 本机开发配置。`pnpm env:init` 会据此生成 .env，并把 ${...} 换成仓库根目录 .env 里的值。
PORT=4104
HOST=127.0.0.1
LOG_LEVEL=info
# 启动时执行本服务的数据库迁移
MIGRATE_ON_START=true
DATABASE_URL=postgres://svc_conversation:${CONVERSATION_DB_PASSWORD}@127.0.0.1:${POSTGRES_HOST_PORT}/conversation?sslmode=disable
NATS_URL=nats://127.0.0.1:${NATS_HOST_PORT}
NATS_USER=${NATS_USER}
NATS_PASSWORD=${NATS_PASSWORD}
AGENT_URL=http://127.0.0.1:4103
MODEL_GATEWAY_URL=http://127.0.0.1:4108
# 用户确认任务单后交给 task 建任务
TASK_URL=http://127.0.0.1:4105
