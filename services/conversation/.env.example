# conversation 本机开发配置。`pnpm env:init` 会据此生成 .env，并把 ${...} 换成仓库根目录 .env 里的值。
PORT=4104
HOST=127.0.0.1
LOG_LEVEL=info
# 启动时执行本服务的数据库迁移
MIGRATE_ON_START=true
DATABASE_URL=postgres://svc_conversation:${CONVERSATION_DB_PASSWORD}@127.0.0.1:${POSTGRES_HOST_PORT}/conversation?sslmode=disable
NATS_URL=nats://127.0.0.1:${NATS_HOST_PORT}
NATS_USER=${NATS_USER}
NATS_PASSWORD=${NATS_PASSWORD}
AGENT_URL=http://127.0.0.1:4103
MODEL_GATEWAY_URL=http://127.0.0.1:4108
# 非流式模型请求总超时，覆盖接需求生成任务单的推理时长
MODEL_GATEWAY_TIMEOUT_MS=180000
# 接需求一步只调用一次模型，输出上限留足余量
INTAKE_MAX_TOKENS=16000
# 普通回复的输出上限也包含推理 token；达到上限保留正文供用户继续，不自动重试。
REPLY_MAX_TOKENS=8192
# 私聊带整段对话，快到模型上下文窗口时用这个便宜模型压缩较早部分（ADR 0016 §8）
# CONTEXT_SUMMARY_MODEL=deepseek/deepseek-v4.1-flash
# 用户确认任务单后交给 task 建任务
TASK_URL=http://127.0.0.1:4105
# 核对用户随消息发的文件（素材存在 canvas）
CANVAS_URL=http://127.0.0.1:4106
# 接需求时解析用户上传的素材
INSPECTOR_URL=http://127.0.0.1:4109
# 6.1 群关系和消息准入限制
GROUP_MAX_MEMBERS=50
GROUP_MAX_PER_USER=20
GROUP_MESSAGES_PER_MINUTE=30
GROUP_STREAMS_PER_USER=3
