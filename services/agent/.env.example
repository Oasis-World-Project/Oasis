# agent 本机开发配置。`pnpm env:init` 会据此生成 .env，并把 ${...} 换成仓库根目录 .env 里的值。
PORT=4103
HOST=127.0.0.1
LOG_LEVEL=info
DATABASE_URL=postgres://svc_agent:${AGENT_DB_PASSWORD}@127.0.0.1:${POSTGRES_HOST_PORT}/agent
NATS_URL=nats://127.0.0.1:${NATS_HOST_PORT}
NATS_USER=${NATS_USER}
NATS_PASSWORD=${NATS_PASSWORD}
