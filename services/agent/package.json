{
  "name": "@oasis/agent",
  "version": "0.0.0",
  "private": true,
  "description": "模型目录（每个 AI 几档型号）、开一轮的型号路由、用户给 AI 们的设置（只用国内模型、每个 AI 用哪一档）",
  "type": "module",
  "files": [
    "dist",
    "migrations",
    "playbooks"
  ],
  "scripts": {
    "dev": "node ../../scripts/dev-service.mjs src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@oasis/contracts": "workspace:*",
    "@oasis/service-kit": "workspace:*",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@oasis/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
