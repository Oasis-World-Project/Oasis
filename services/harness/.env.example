# harness 本机开发配置。`pnpm env:init` 会据此生成 .env，并把 ${...} 换成仓库根目录 .env 里的值。
PORT=4107
HOST=127.0.0.1
LOG_LEVEL=info
# 启动时执行本服务的数据库迁移
MIGRATE_ON_START=true
DATABASE_URL=postgres://svc_harness:${HARNESS_DB_PASSWORD}@127.0.0.1:${POSTGRES_HOST_PORT}/harness?sslmode=disable
NATS_URL=nats://127.0.0.1:${NATS_HOST_PORT}
NATS_USER=${NATS_USER}
NATS_PASSWORD=${NATS_PASSWORD}
MODEL_GATEWAY_URL=http://127.0.0.1:4108
# 取用户上传的素材放进沙箱
CANVAS_URL=http://127.0.0.1:4106
# 对象存储：运行产出和 dsh 会话存档
S3_ENDPOINT=http://127.0.0.1:${S3_HOST_PORT}
S3_ACCESS_KEY=${S3_ACCESS_KEY}
S3_SECRET_KEY=${S3_SECRET_KEY}
# 沙箱：镜像要先构建（pnpm sandbox:build），网络由 pnpm infra:up 创建。
# Docker 的 socket 一般不用填：Linux/macOS 默认 /var/run/docker.sock，Windows 默认 Docker Desktop 的命名管道。
# DOCKER_SOCKET=
# 沙箱里装软件包用的仓库（经出口代理 sandbox-egress，只放行根目录 .env 里列出的域名）
SANDBOX_NPM_REGISTRY=${SANDBOX_NPM_REGISTRY}
SANDBOX_PIP_INDEX_URL=${SANDBOX_PIP_INDEX_URL}
# 批次只有调度并发和单次文件传输边界；预算/token/超时由具体调用显式给出。
OASIS_BATCH_CONCURRENCY=4
OASIS_BATCH_MAX_INPUT_BYTES=5242880

FILE_TRANSFER_TIMEOUT_MS=600000

# 可续租窗口，不是任务寿命；到窗口边缘不会中断目标。
RUN_LEASE_MS=300000
RUN_KEY_TTL_SECONDS=21600
GOAL_ROUND_WINDOW=256
# 接管依赖暂不可用时的对账间隔；不是任务时长或重试次数上限。
RECOVERY_INTERVAL_MS=15000
