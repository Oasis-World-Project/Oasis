{
  "name": "@oasis/harness",
  "version": "0.0.0",
  "private": true,
  "description": "Agent 运行时：唯一接触 DeepSeek Harness 的服务，把工作流节点变成一次 agent 运行",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@oasis/service-kit": "workspace:*"
  },
  "devDependencies": {
    "@oasis/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
