{
  "name": "@oasis/harness",
  "version": "0.0.0",
  "private": true,
  "description": "Agent 运行时：唯一接触 DeepSeek Harness 的服务，每次运行起一个沙箱容器跑 dsh",
  "type": "module",
  "files": [
    "dist",
    "migrations",
    "seccomp-profile.json",
    "media"
  ],
  "scripts": {
    "dev": "node ../../scripts/dev-service.mjs --no-watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/dsh-sdk-protocol": "0.2.1-rc.5",
    "@oasis/contracts": "workspace:*",
    "@oasis/live-page": "workspace:*",
    "@oasis/service-kit": "workspace:*",
    "drizzle-orm": "catalog:",
    "fast-xml-parser": "5.11.2",
    "fflate": "catalog:",
    "parse5": "catalog:",
    "pg": "catalog:",
    "sharp": "0.35.5",
    "tar-stream": "3.2.2",
    "unpdf": "1.9.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@oasis/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/tar-stream": "3.1.5",
    "fastify": "catalog:",
    "pino": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
