{
  // 这两个工具由 scripts/check-engineering.mjs 通过 `pnpm exec` 动态调用，knip 静态分析看不到
  // playwright-core 仅在锁定版本的预览镜像内安装，不在宿主工作区依赖中。
  "ignoreDependencies": ["dependency-cruiser", "jscpd", "playwright-core"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      // 媒体烟测用 createRequire 加载 canvas 已声明的 fflate；根包不重复安装。
      "ignoreDependencies": ["fflate"],
    },
    // 只有 JSON 配置，没有源码入口
    "packages/tsconfig": {
      "entry": [],
      "project": [],
    },
    // 沙箱镜像里的命令（不经 package.json 引用，由 Dockerfile 装进镜像）
    "services/harness": {
      // dsh 仅安装于精确版本沙箱镜像，离线集成测试在容器内调用。
      "ignoreBinaries": ["dsh"],
      // 原生附件恢复回归仅在镜像内加载 dsh 自带的精确依赖；宿主不重复安装底座。
      "ignoreDependencies": ["@deepseek-ai/cordis", "@deepseek-ai/dsh-attachment-local"],
      // 解析 worker 由 Worker URL 按源码/编译后扩展名加载，静态 import 图不可见。
      "entry": [
        "src/main.ts",
        "sandbox/oasis-tool.ts",
        "src/adapter/profile/node-goal.mjs",
        "src/adapter/test/native-provider.mjs",
        "src/service/file-inspection-worker.ts",
        "preview/controller.mjs",
        "media/media-check.mjs",
      ],
    },
    "services/canvas": {
      // 开发启动器把入口作为参数传入；显式保留 main，避免覆盖默认入口推断。
      "entry": ["src/main.ts", "src/service/preview-worker.ts"],
    },
    // preload 由 Electron 按路径加载（BrowserWindow 的 webPreferences.preload），不经 import
    "apps/desktop": {
      "entry": ["src/main.ts", "src/preload.cts", "test/model-preview-smoke.cjs"],
    },
    // model:smoke 通过 Vite HTML 动态挂载的测试页面，不进入产品入口。
    "apps/web": {
      "entry": ["test/model-preview-host.tsx"],
    },
    // exports 用了 "./*" 通配，knip 推不出对应的源码入口
    "packages/contracts": {
      "entry": ["src/*.ts"],
    },
  },
}
