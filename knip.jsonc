{
  // 这两个工具由 scripts/check-engineering.mjs 通过 `pnpm exec` 动态调用，knip 静态分析看不到
  // playwright-core 仅在锁定版本的预览镜像内安装，不在宿主工作区依赖中。
  "ignoreDependencies": ["dependency-cruiser", "jscpd", "playwright-core"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
    },
    // 只有 JSON 配置，没有源码入口
    "packages/tsconfig": {
      "entry": [],
      "project": [],
    },
    // 沙箱镜像里的命令（不经 package.json 引用，由 Dockerfile 装进镜像）
    "services/harness": {
      // 解析 worker 由 Worker URL 按源码/编译后扩展名加载，静态 import 图不可见。
      "entry": [
        "sandbox/oasis-tool.ts",
        "src/service/file-inspection-worker.ts",
        "preview/controller.mjs",
      ],
    },
    "services/canvas": {
      "entry": ["src/service/preview-worker.ts"],
    },
    // preload 由 Electron 按路径加载（BrowserWindow 的 webPreferences.preload），不经 import
    "apps/desktop": {
      "entry": ["src/main.ts", "src/preload.cts"],
    },
    // exports 用了 "./*" 通配，knip 推不出对应的源码入口
    "packages/contracts": {
      "entry": ["src/*.ts"],
    },
  },
}
