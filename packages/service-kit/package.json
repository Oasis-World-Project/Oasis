{
  "name": "@oasis/service-kit",
  "version": "0.0.0",
  "private": true,
  "description": "所有 Node 服务共用的启动底座：配置、日志、HTTP 探针、依赖连接、优雅关闭（只放基础设施，不放业务逻辑）",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nats-io/jetstream": "catalog:",
    "@nats-io/transport-node": "catalog:",
    "@oasis/contracts": "workspace:*",
    "dbmate": "catalog:",
    "fastify": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@oasis/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
